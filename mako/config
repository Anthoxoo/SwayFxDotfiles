font=JetBrainsMono Nerd Font 10
background-color=#141416F2
text-color=#e5e5e5FF
border-color=#ff8800FF
progress-color=over #ff880044

width=340
height=110
margin=12
padding=12
border-size=2
border-radius=0

icons=1
max-icon-size=48
icon-location=left
markup=1
actions=1
 format=<b>%s</b>\n%b

default-timeout=5000
ignore-timeout=0
layer=overlay
anchor=top-right

on-button-left=invoke-default-action
on-button-right=dismiss
on-button-middle=dismiss-all

[urgency=low]
border-color=#2a2a2cFF
default-timeout=3000

[urgency=high]
border-color=#e05252FF
default-timeout=0
