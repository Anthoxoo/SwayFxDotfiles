# Colors (windows, GTK, icons, terminal, Quickshell, nvim): global theme, see
# ~/.config/themes (`~/.config/themes/theme set <id>`). The GTK theme, color-scheme,
# accent and icons are written to gsettings by that script (GTK reads gsettings on Wayland).
# Cursor and font stay here.
exec_always {
    gsettings set org.gnome.desktop.interface cursor-theme 'breeze_cursors'
    gsettings set org.gnome.desktop.interface cursor-size 24
    gsettings set org.gnome.desktop.interface font-name 'Noto Sans 10'
}

# Curseur
seat seat0 xcursor_theme breeze_cursors 24

# SwayFX
corner_radius 0
blur enable
blur_radius 6
blur_passes 3

# Flou sous la barre Quickshell (namespace défini dans modules/Bar.qml)
layer_effects "qs-bar" {
    blur enable;
    blur_ignore_transparent enable;
}

# Gaps (définis une seule fois)
gaps inner 5
gaps outer 5

# Pas de barre de titre, bordure 1 px
default_border pixel 1
default_floating_border pixel 1

# Police (barres de titre / onglets)
font pango:JetBrainsMono Nerd Font 12

# Title format for windows
for_window [shell="xdg_shell"] title_format "%title (%app_id)"
for_window [shell="xwayland"] title_format "%class - %title"

# Window colors (client.*): generated by the current theme
include ~/.config/themes/current/sway.conf
