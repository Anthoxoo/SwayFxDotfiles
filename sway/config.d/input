### Input configuration
#
# Read `man 5 sway-input` for more information about this section.

# Clavier
input type:keyboard {
    xkb_layout "fr"
}

# Souris
input type:pointer {
    pointer_accel -0.2
    accel_profile "flat"
}

# Touchpad configuration
#input type:touchpad {
#    dwt enabled
#    tap enabled
#    natural_scroll enabled
#}

# OpenTabletDriver tablet (desktop) restricted to its monitor
input "OpenTabletDriver Virtual Tablet" {
    map_to_output DP-1
    accel_profile flat
}

