# Logo key. Use Mod1 for Alt.
set $mod Mod4

# Add Vim key support
set $left h
set $down j
set $up k
set $right l

# Set default terminal emulator
set $term alacritty

# Application launcher (Quickshell)
set $launcher ~/.config/quickshell/scripts/toggle-launcher.sh

# Power Menu (Quickshell)
set $powermenu ~/.config/quickshell/scripts/toggle-power.sh

# Code Editor
set $code-editor zed

# Prefered Browser
set $browser firefox

# File manager
set $file-manager nautilus

### Key bindings
#
# Basics:
#
    # Launch the terminal
    bindsym $mod+Return exec $term

    # Open the power menu
    bindsym $mod+Escape exec $powermenu

    # Kill focused window
    bindsym $mod+a kill

    # Start your launcher
    bindsym $mod+d exec $launcher

    # Activities
    bindsym $mod+p exec ~/.config/sway/scripts/window_switcher.sh

    # Quickshell TUI shortcuts (Wi-Fi, Bluetooth, Audio, Battery)
    bindsym $mod+Shift+w exec ~/.config/quickshell/scripts/toggle-wifi.sh
    bindsym $mod+Shift+b exec ~/.config/quickshell/scripts/toggle-bt.sh
    bindsym $mod+Shift+v exec ~/.config/quickshell/scripts/toggle-audio.sh
    bindsym $mod+Shift+p exec ~/.config/quickshell/scripts/toggle-battery.sh

    # Move windows by holding down $mod and left mouse button.
    # Resize them with right mouse button + $mod.
    floating_modifier $mod normal

    # Reload the configuration file
    bindsym $mod+Shift+c reload

    bindsym $mod+s exec obsidian

#resize mode
mode "resize" {
    bindsym $left resize shrink width 10px
    bindsym $down resize grow height 10px
    bindsym $up resize shrink height 10px
    bindsym $right resize grow width 10px

    bindsym Left resize shrink width 10px
    bindsym Down resize grow height 10px
    bindsym Up resize shrink height 10px
    bindsym Right resize grow width 10px

    bindsym Return mode "default"
    bindsym Escape mode "default"
}
bindsym $mod+r mode "resize"

#
# Moving around:
#
    bindsym {
        # Change window focus
        $mod+Left focus left
        $mod+Down focus down
        $mod+Up focus up
        $mod+Right focus right
        # Vim key support

        # Move the focused window
        $mod+Shift+Left move left
        $mod+Shift+Down move down
        $mod+Shift+Up move up
        $mod+Shift+Right move right
        # Vim key support
        $mod+Shift+$left move left
        $mod+Shift+$down move down
        $mod+Shift+$up move up
        $mod+Shift+$right move right
    }

#
# Workspaces:
#
    bindcode {
        # Switch to workspace
        $mod+10 workspace number 1
        $mod+11 workspace number 2
        $mod+12 workspace number 3
        $mod+13 workspace number 4
        $mod+14 workspace number 5
        $mod+15 workspace number 6
        $mod+16 workspace number 7
        $mod+17 workspace number 8
        $mod+18 workspace number 9
        $mod+19 workspace number 10

        # Move focused container to workspace
        $mod+Shift+10 move container to workspace number 1
        $mod+Shift+11 move container to workspace number 2
        $mod+Shift+12 move container to workspace number 3
        $mod+Shift+13 move container to workspace number 4
        $mod+Shift+14 move container to workspace number 5
        $mod+Shift+15 move container to workspace number 6
        $mod+Shift+16 move container to workspace number 7
        $mod+Shift+17 move container to workspace number 8
        $mod+Shift+18 move container to workspace number 9
        $mod+Shift+19 move container to workspace number 10
    }

#
# Layout stuff:
#
    exec_always autotiling

    # Make the current focus fullscreen
    bindsym $mod+f fullscreen

    # Toggle between tiling and floating mode
    bindsym $mod+space floating toggle

#
# Resizing containers:
#
    bindsym {
        # Resize with arrow keys
        $mod+ctrl+Right resize shrink width 10 px
        $mod+ctrl+Up resize grow height 10 px
        $mod+ctrl+Down resize shrink height 10 px
        $mod+ctrl+Left resize grow width 10 px
        # Resize with Vim keys
        $mod+ctrl+$right resize shrink width 10 px
        $mod+ctrl+$up resize grow height 10 px
        $mod+ctrl+$down resize shrink height 10 px
        $mod+ctrl+$left resize grow width 10 px
    }

    # Resize floating windows with mouse scroll:
    bindsym --whole-window --border {
        $mod+button4 resize shrink height 5 px or 5 ppt
        $mod+button5 resize grow height 5 px or 5 ppt
        $mod+Shift+button4 resize shrink width 5 px or 5 ppt
        $mod+Shift+button5 resize grow width 5 px or 5 ppt
    }

#
# Media Keys
#
    bindsym {
        # Volume
        XF86AudioRaiseVolume exec pamixer -ui 2 && ~/.config/quickshell/scripts/status_refresh.sh
        XF86AudioLowerVolume exec pamixer -ud 2 && ~/.config/quickshell/scripts/status_refresh.sh
        XF86AudioMute exec pamixer --toggle-mute && ~/.config/quickshell/scripts/status_refresh.sh

        # Player
        XF86AudioPlay exec playerctl play-pause
        XF86AudioNext exec playerctl next
        XF86AudioPrev exec playerctl previous

        # Backlight
        XF86MonBrightnessUp exec ~/.config/quickshell/scripts/brightness.sh up 5
        XF86MonBrightnessDown exec ~/.config/quickshell/scripts/brightness.sh down 5
    }

#
# App shortcuts
#
    # Launch the file explorer
    bindsym $mod+e exec $file-manager

    # Launch the browser
    bindsym $mod+b exec $browser

    # Launch code editor
    bindsym $mod+v exec $code-editor

#
# Screenshots
#
    # Snip a selection and pipe to swappy
    bindsym print exec grim -g "$(slurp)" - | swappy -f -
    # Screenshot a window and pipe to swappy
    bindsym Ctrl+Print exec ~/.config/sway/scripts/screenshot_window.sh
    # Screenshot the current display and pipe to swappy
    bindsym Shift+Print exec ~/.config/sway/scripts/screenshot_display.sh

# Notifications Quickshell (fermer tout / mode Ne pas déranger)
bindsym $mod+n exec ~/.config/quickshell/scripts/notif-ctl.sh clear-notifs
bindsym $mod+Shift+n exec ~/.config/quickshell/scripts/notif-ctl.sh toggle-dnd
