# Environnement pour systemd --user et D-Bus (portails, notifications, etc.)
exec systemctl --user import-environment DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP
exec dbus-update-activation-environment --systemd DISPLAY WAYLAND_DISPLAY SWAYSOCK XDG_CURRENT_DESKTOP=sway

# Polkit authentication agent (KDE or GNOME, whichever is installed)
exec ~/.config/sway/scripts/polkit-agent.sh

# Autotiling — une seule instance (exec, pas exec_always : sinon une de plus à chaque reload)
exec autotiling

# OpenTabletDriver (desktop): its user service waits for graphical-session.target, which
# sway never reaches, so start it here. No-op where the service isn't installed.
exec sh -c 'systemctl --user cat opentabletdriver.service >/dev/null 2>&1 && exec systemctl --user start opentabletdriver.service'

# Quickshell : barre, lanceur, menus, notifications, OSD, verrouillage
exec_always ~/.config/quickshell/scripts/start-quickshell.sh

# Idle / verrouillage : voir config.d/lock (une seule instance de swayidle)
# Notifications : gérées par Quickshell (mako retiré)
# Lanceur : Quickshell (nwg-drawer retiré, non installé)
# firewall-applet : non installé, retiré
