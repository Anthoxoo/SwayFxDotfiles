# Sway (swayfx) — point d'entrée
# Toute la configuration est découpée dans config.d/ (chargé par ordre alphabétique) :
#   application_defaults   règles de fenêtres
#   autostart_applications démons et services lancés au démarrage
#   default                variables, raccourcis
#   input                  clavier / souris / tablette
#   lock                   verrouillage et mise en veille
#   output                 écrans
#   theme                  apparence (couleurs, gaps, swayfx, GTK)

include $HOME/.config/sway/config.d/*
