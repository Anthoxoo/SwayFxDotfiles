-    discoveryAgent->setLowEnergyDiscoveryTimeout(0); // Continuous scanning
+    // Each window ends by itself and emits finished(); onScanFinished() schedules the next one.
+    discoveryAgent->setLowEnergyDiscoveryTimeout(scanWindowMs);
+
+    pauseTimer = new QTimer(this);
+    pauseTimer->setSingleShot(true);
+    pauseTimer->setInterval(scanPauseMs);
+    connect(pauseTimer, &QTimer::timeout, this, [this]() {
+        if (scanWanted)
+            discoveryAgent->start(QBluetoothDeviceDiscoveryAgent::LowEnergyMethod);
+    });
 
