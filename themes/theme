#!/usr/bin/env python3
"""Global theme manager (omarchy-style).

A theme is a directory ~/.config/themes/<id>/ containing:
  colors.toml     palette (omarchy format: accent, background, foreground, color0..15
                  + optional [ui], [syntax] and [gtk] sections)
  backgrounds/    the theme's wallpapers (usually a link to ~/.config/walls/<dir>)
  <file>          optional: replaces the template of the same name (e.g. alacritty.toml)

`theme set <id>` generates ~/.config/themes/current/:
  palette.json    every resolved color (read by Quickshell and Neovim)
  one file per template in templates/ (sway, alacritty, GTK, Zed, btop, fuzzel, Firefox, zsh)
then applies the theme to running applications.

Templates: {{ key }} -> #rrggbb, {{ key_strip }} -> rrggbb, {{ key_rgb }} -> r, g, b,
{{ key_ansi }} -> r;g;b (truecolor escape codes)
"""

import json
import os
import re
import subprocess
import sys
import tomllib
from pathlib import Path

ROOT = Path(os.environ.get("THEMES_DIR", Path(__file__).resolve().parent))
TEMPLATES = ROOT / "templates"
CURRENT = ROOT / "current"

HEX_RE = re.compile(r"^#[0-9a-fA-F]{6}$")


# ---------------------------------------------------------------- colors
def rgb(h):
    return tuple(int(h[i:i + 2], 16) for i in (1, 3, 5))


def hexc(t):
    return "#" + "".join(f"{max(0, min(255, round(v))):02x}" for v in t)


def mix(a, b, t):
    """Blend a towards b (t = share of b)."""
    ra, rb = rgb(a), rgb(b)
    return hexc(tuple(x + (y - x) * t for x, y in zip(ra, rb)))


def over(fg, bg, alpha):
    """fg at opacity alpha painted over bg (pre-blended colors for nvim/GTK)."""
    return mix(bg, fg, alpha)


# ---------------------------------------------------------------- palette
def load_theme(tid):
    d = ROOT / tid
    f = d / "colors.toml"
    if not f.is_file():
        raise SystemExit(f"unknown theme: {tid}")
    with f.open("rb") as fh:
        raw = tomllib.load(fh)
    return d, raw


def resolve(tid, raw):
    """Full palette: the theme's values, otherwise derived from the base colors."""
    ui = raw.get("ui", {})
    syn = raw.get("syntax", {})
    gtk = raw.get("gtk", {})

    def need(k):
        v = raw.get(k)
        if not isinstance(v, str) or not HEX_RE.match(v):
            raise SystemExit(f"{tid}/colors.toml: '{k}' missing or invalid (expected #rrggbb)")
        return v.lower()

    p = {"id": tid, "name": raw.get("name", tid)}
    bg, fg, acc = need("background"), need("foreground"), need("accent")
    for i in range(16):
        p[f"color{i}"] = need(f"color{i}")
    p.update(background=bg, foreground=fg, accent=acc)
    p["cursor"] = raw.get("cursor", acc)
    p["selection_background"] = raw.get("selection_background", over(acc, bg, 0.24))
    p["selection_foreground"] = raw.get("selection_foreground", fg)

    def put(section, key, default):
        v = section.get(key, default)
        if isinstance(v, str) and v.startswith("#"):
            v = v.lower()
        p[key] = v

    # --- interface (Quickshell, GTK, sway): surfaces from darkest to lightest
    put(ui, "inset", mix(bg, "#000000", 0.3))
    put(ui, "surface", mix(bg, fg, 0.03))
    put(ui, "row_hover", mix(bg, fg, 0.045))
    put(ui, "hover", mix(bg, fg, 0.10))
    put(ui, "border", mix(bg, fg, 0.11))
    put(ui, "separator", mix(bg, fg, 0.13))
    # text, from most to least readable
    put(ui, "subtle", mix(fg, bg, 0.2))
    put(ui, "dim", mix(fg, bg, 0.35))
    put(ui, "muted", mix(fg, bg, 0.43))
    put(ui, "disabled", mix(fg, bg, 0.5))
    put(ui, "placeholder", mix(fg, bg, 0.56))
    # states
    put(ui, "field", p["row_hover"])  # input fields, active tab (Firefox)
    put(ui, "accent_fg", bg)
    put(ui, "urgent", p["color1"])
    put(ui, "warning", p["color3"])
    put(ui, "success", p["color6"])
    # ls colors (LS_COLORS in zsh)
    put(ui, "ls_link", p["color4"])
    put(ui, "ls_exec", p["color2"])
    put(ui, "ls_archive", p["color1"])
    # opacities (Quickshell)
    put(ui, "panel_alpha", 0.95)
    put(ui, "bar_alpha", 0.72)

    # --- editors (Neovim, Zed)
    put(syn, "editor_fg", fg)
    put(syn, "keyword", acc)
    put(syn, "function", p["color4"])
    put(syn, "type", p["color3"])
    put(syn, "string", p["color2"])
    put(syn, "number", p["color5"])
    put(syn, "regex", p["color6"])
    put(syn, "escape", p["color11"])
    put(syn, "attribute", p["color3"])
    put(syn, "variable", fg)
    put(syn, "operator", p["color6"])
    put(syn, "punctuation", p["placeholder"])
    put(syn, "bracket", p["dim"])
    put(syn, "comment", p["disabled"])
    put(syn, "line_nr", mix(fg, bg, 0.65))
    put(syn, "guide_active", p["color8"])
    put(syn, "special", p["color11"])  # second warm color (Zed: renamed files, cursors)
    # pre-blended backgrounds (nvim has no alpha channel)
    put(syn, "visual", over(acc, bg, 0.24))
    put(syn, "search", over(p["warning"], bg, 0.25))
    put(syn, "match_paren", over(acc, bg, 0.19))
    put(syn, "diff_add", over(p["success"], bg, 0.16))
    put(syn, "diff_delete", over(p["urgent"], bg, 0.16))
    put(syn, "diff_change", over(acc, bg, 0.16))
    put(syn, "diff_text", over(acc, bg, 0.30))
    put(syn, "warning_bg", over(p["warning"], bg, 0.16))
    put(syn, "info_bg", over(p["success"], bg, 0.16))
    put(syn, "special_bg", over(p["special"], bg, 0.16))
    # status badge borders (Zed)
    for k in ("accent", "urgent", "warning", "success", "special"):
        put(syn, k + "_border", over(p[k], bg, 0.4))
    # dimmed variants of ANSI colors 0-7 (Zed terminal)
    for i in range(8):
        put(syn, f"dim{i}", over(p[f"color{i}"], bg, 0.7))

    # --- GTK / icons (dark themes only)
    put(gtk, "gtk_theme", "adw-gtk3-dark")
    put(gtk, "icon_theme", "Papirus-Dark")
    put(gtk, "gnome_accent", "blue")

    for k, v in p.items():
        if isinstance(v, str) and v.startswith("#") and not HEX_RE.match(v):
            raise SystemExit(f"{tid}/colors.toml: '{k}' = {v} is invalid (expected #rrggbb)")
    return p


def template_vars(p):
    out = {}
    for k, v in p.items():
        out[k] = str(v)
        if isinstance(v, str) and HEX_RE.match(v):
            out[k + "_strip"] = v[1:]
            out[k + "_rgb"] = ", ".join(str(c) for c in rgb(v))
            out[k + "_ansi"] = ";".join(str(c) for c in rgb(v))
    return out


TPL_RE = re.compile(r"\{\{\s*([a-z0-9_]+)\s*\}\}")


def render(text, vars_, name):
    def sub(m):
        k = m.group(1)
        if k not in vars_:
            raise SystemExit(f"template {name}: unknown variable '{k}'")
        return vars_[k]
    return TPL_RE.sub(sub, text)


def write_atomic(path, text):
    tmp = path.with_name("." + path.name + ".tmp")
    tmp.write_text(text)
    os.replace(tmp, path)


# ---------------------------------------------------------------- commands
def themes():
    return sorted(d.name for d in ROOT.iterdir()
                  if d.is_dir() and (d / "colors.toml").is_file())


# Renamed themes: an old id (in current/palette.json, a script, another machine) still works
RENAMED = {"kanagawa": "nord", "rosso": "red-black"}


def current_id():
    try:
        tid = json.loads((CURRENT / "palette.json").read_text())["id"]
    except (OSError, ValueError, KeyError):
        return None
    return RENAMED.get(tid, tid)


def build(tid):
    d, raw = load_theme(tid)
    p = resolve(tid, raw)
    # Path as is (link followed one level, no resolve()): it must match the
    # ~/.config/walls/... paths Quickshell has already saved.
    bgs = d / "backgrounds"
    if bgs.is_symlink():
        bgs = Path(os.path.normpath(bgs.parent / os.readlink(bgs)))
    p["backgrounds"] = str(bgs) if bgs.is_dir() else ""
    vars_ = template_vars(p)

    CURRENT.mkdir(exist_ok=True)
    rendered = {}
    for tpl in sorted(TEMPLATES.iterdir()):
        if tpl.is_file():
            own = d / tpl.name  # a theme can ship its own version of a file
            src = own if own.is_file() else tpl
            rendered[tpl.name] = render(src.read_text(), vars_, src)
    # everything is validated before writing: no half-applied theme
    for name, text in rendered.items():
        write_atomic(CURRENT / name, text)
    write_atomic(CURRENT / "palette.json", json.dumps(p, indent=2) + "\n")
    install()
    return p


# Files copied where the application expects them (it can't read current/):
# Zed loads every ~/.config/zed/themes/*.json and hot-reloads; settings.json
# points at the "Theme" theme once and for all.
INSTALL = {
    "zed.json": Path.home() / ".config/zed/themes/theme.json",
    # btop.conf: color_theme = "theme"
    "btop.theme": Path.home() / ".config/btop/themes/theme.theme",
}


# Firefox: only profiles prepared by firefox-setup.sh (chrome/ directory present).
# userChrome.css is only read when Firefox starts.
FIREFOX = {
    "firefox-userChrome.css": "chrome/userChrome.css",
    "firefox-userContent.css": "chrome/userContent.css",
    "firefox-user.js": "user.js",
}


def firefox_profiles():
    for base in (Path.home() / ".mozilla/firefox",
                 Path.home() / ".config/mozilla/firefox",  # XDG layout (recent Firefox)
                 Path.home() / ".var/app/org.mozilla.firefox/.mozilla/firefox"):
        if base.is_dir():
            for prof in base.iterdir():
                if (prof / "prefs.js").is_file() and (prof / "chrome").is_dir():
                    yield prof


def install():
    for name, dest in INSTALL.items():
        if (CURRENT / name).is_file() and dest.parent.is_dir():
            write_atomic(dest, (CURRENT / name).read_text())
    for prof in firefox_profiles():
        for name, rel in FIREFOX.items():
            if (CURRENT / name).is_file():
                write_atomic(prof / rel, (CURRENT / name).read_text())


def quiet(cmd):
    try:
        subprocess.run(cmd, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        pass


def apply_live(p):
    # sway: window colors without `swaymsg reload` (which would restart Quickshell)
    if os.environ.get("SWAYSOCK"):
        lines = [l.strip() for l in (CURRENT / "sway.conf").read_text().splitlines()
                 if l.strip().startswith("client.")]
        if lines:
            quiet(["swaymsg", "; ".join(lines)])
    # GTK: switching the GTK theme makes running GTK 3 apps re-read gtk.css
    gs = ["gsettings", "set", "org.gnome.desktop.interface"]
    quiet(gs + ["gtk-theme", "Adwaita"])
    quiet(gs + ["gtk-theme", p["gtk_theme"]])
    quiet(gs + ["color-scheme", "prefer-dark"])
    quiet(gs + ["accent-color", p["gnome_accent"]])
    quiet(gs + ["icon-theme", p["icon_theme"]])
    # Neovim: autocmd Signal SIGUSR1 -> reload the "theme" colorscheme
    quiet(["pkill", "-USR1", "-x", "nvim"])
    # btop: SIGUSR2 = re-read btop.conf (and so the theme)
    quiet(["pkill", "-USR2", "-x", "btop"])
    # Quickshell and alacritty watch their files: nothing to do


def cmd_list(as_json):
    if not as_json:
        cur = current_id()
        for t in themes():
            print(("* " if t == cur else "  ") + t)
        return
    out = []
    for t in themes():
        try:
            p = resolve(t, load_theme(t)[1])
        except SystemExit as e:
            print(e, file=sys.stderr)
            continue
        out.append({k: p[k] for k in ("id", "name", "background", "foreground",
                                      "accent", "surface", "border")}
                   | {"colors": [p[f"color{i}"] for i in (1, 2, 3, 4, 5, 6)]})
    print(json.dumps(out))


def cmd_step(delta):
    ts = themes()
    cur = current_id()
    i = ts.index(cur) if cur in ts else -1
    return ts[(i + delta) % len(ts)]


def main(argv):
    if not argv or argv[0] in ("-h", "--help", "help"):
        print("usage: theme list [--json] | current | set <id> | next | prev | apply")
        return
    cmd, args = argv[0], argv[1:]
    if cmd == "list":
        cmd_list("--json" in args)
    elif cmd == "current":
        print(current_id() or "")
    elif cmd in ("set", "next", "prev", "apply"):
        if cmd == "set":
            if not args:
                raise SystemExit("usage: theme set <id>")
            tid = RENAMED.get(args[0], args[0])
        elif cmd == "apply":
            tid = current_id() or "orange-black"
        else:
            tid = cmd_step(1 if cmd == "next" else -1)
        p = build(tid)
        apply_live(p)
        print(f"theme: {p['name']}")
    else:
        raise SystemExit(f"unknown command: {cmd}")


if __name__ == "__main__":
    main(sys.argv[1:])
