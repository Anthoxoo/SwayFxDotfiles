# Généré par ~/.config/themes/theme (template : templates/btop.theme)
theme[main_bg]="{{ background }}"
theme[main_fg]="{{ foreground }}"
theme[title]="{{ foreground }}"
theme[hi_fg]="{{ accent }}"
theme[selected_bg]="{{ hover }}"
theme[selected_fg]="{{ accent }}"
theme[inactive_fg]="{{ placeholder }}"
theme[graph_text]="{{ muted }}"
theme[meter_bg]="{{ border }}"
theme[proc_misc]="{{ accent }}"
theme[cpu_box]="{{ border }}"
theme[mem_box]="{{ border }}"
theme[net_box]="{{ border }}"
theme[proc_box]="{{ border }}"
theme[div_line]="{{ border }}"
theme[temp_start]="{{ success }}"
theme[temp_mid]="{{ warning }}"
theme[temp_end]="{{ urgent }}"
theme[cpu_start]="{{ success }}"
theme[cpu_mid]="{{ accent }}"
theme[cpu_end]="{{ urgent }}"
theme[free_start]="{{ success_border }}"
theme[free_mid]=""
theme[free_end]="{{ success }}"
theme[cached_start]="{{ color4 }}"
theme[cached_mid]=""
theme[cached_end]="{{ color12 }}"
theme[available_start]="{{ warning_border }}"
theme[available_mid]=""
theme[available_end]="{{ warning }}"
theme[used_start]="{{ accent_border }}"
theme[used_mid]=""
theme[used_end]="{{ accent }}"
theme[download_start]="{{ success_border }}"
theme[download_mid]=""
theme[download_end]="{{ success }}"
theme[upload_start]="{{ accent_border }}"
theme[upload_mid]=""
theme[upload_end]="{{ accent }}"
theme[process_start]="{{ success }}"
theme[process_mid]="{{ warning }}"
theme[process_end]="{{ urgent }}"
