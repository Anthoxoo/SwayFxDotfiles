{
  "$schema": "https://zed.dev/schema/themes/v0.2.0.json",
  "name": "Theme",
  "author": "~/.config/themes",
  "themes": [
    {
      "name": "Theme",
      "appearance": "dark",
      "style": {
        "accents": [
          "{{ function }}",
          "{{ string }}",
          "{{ type }}",
          "{{ dim }}"
        ],
        "border": "{{ border }}",
        "border.variant": "{{ hover }}",
        "border.focused": "{{ accent }}",
        "border.selected": "{{ accent }}",
        "border.transparent": "#00000000",
        "border.disabled": "{{ row_hover }}",
        "background": "{{ inset }}",
        "surface.background": "{{ inset }}",
        "elevated_surface.background": "{{ surface }}",
        "element.background": "{{ surface }}",
        "element.hover": "{{ hover }}",
        "element.active": "{{ separator }}",
        "element.selected": "{{ hover }}",
        "element.disabled": "{{ inset }}",
        "drop_target.background": "{{ accent }}26",
        "ghost_element.background": "#00000000",
        "ghost_element.hover": "{{ row_hover }}",
        "ghost_element.active": "{{ border }}",
        "ghost_element.selected": "{{ hover }}",
        "ghost_element.disabled": "{{ inset }}",
        "text": "{{ foreground }}",
        "text.muted": "{{ muted }}",
        "text.placeholder": "{{ placeholder }}",
        "text.disabled": "{{ disabled }}",
        "text.accent": "{{ accent }}",
        "icon": "{{ subtle }}",
        "icon.muted": "{{ muted }}",
        "icon.disabled": "{{ placeholder }}",
        "icon.placeholder": "{{ muted }}",
        "icon.accent": "{{ accent }}",
        "status_bar.background": "{{ inset }}",
        "title_bar.background": "{{ inset }}",
        "title_bar.inactive_background": "{{ inset }}",
        "toolbar.background": "{{ background }}",
        "tab_bar.background": "{{ inset }}",
        "tab.inactive_background": "{{ inset }}",
        "tab.active_background": "{{ background }}",
        "search.match_background": "{{ warning }}40",
        "panel.background": "{{ inset }}",
        "panel.focused_border": "{{ accent }}",
        "panel.indent_guide": "{{ hover }}",
        "panel.indent_guide_hover": "{{ separator }}",
        "panel.indent_guide_active": "{{ guide_active }}",
        "pane.focused_border": "{{ accent }}",
        "pane_group.border": "{{ border }}",
        "scrollbar.thumb.background": "{{ foreground }}14",
        "scrollbar.thumb.hover_background": "{{ foreground }}30",
        "scrollbar.thumb.border": "#00000000",
        "scrollbar.track.background": "#00000000",
        "scrollbar.track.border": "{{ row_hover }}",
        "editor.foreground": "{{ editor_fg }}",
        "editor.background": "{{ background }}",
        "editor.gutter.background": "{{ background }}",
        "editor.subheader.background": "{{ surface }}",
        "editor.active_line.background": "{{ row_hover }}",
        "editor.highlighted_line.background": "{{ hover }}",
        "editor.line_number": "{{ line_nr }}",
        "editor.active_line_number": "{{ accent }}",
        "editor.invisible": "{{ separator }}",
        "editor.wrap_guide": "{{ row_hover }}",
        "editor.active_wrap_guide": "{{ border }}",
        "editor.indent_guide": "{{ hover }}",
        "editor.indent_guide_active": "{{ guide_active }}",
        "editor.document_highlight.read_background": "{{ foreground }}14",
        "editor.document_highlight.write_background": "{{ foreground }}24",
        "editor.document_highlight.bracket_background": "{{ accent }}30",
        "terminal.background": "{{ background }}",
        "terminal.ansi.background": "{{ background }}",
        "terminal.foreground": "{{ foreground }}",
        "terminal.bright_foreground": "{{ color15 }}",
        "terminal.dim_foreground": "{{ muted }}",
        "terminal.ansi.black": "{{ color0 }}",
        "terminal.ansi.bright_black": "{{ color8 }}",
        "terminal.ansi.dim_black": "{{ dim0 }}",
        "terminal.ansi.red": "{{ color1 }}",
        "terminal.ansi.bright_red": "{{ color9 }}",
        "terminal.ansi.dim_red": "{{ dim1 }}",
        "terminal.ansi.green": "{{ color2 }}",
        "terminal.ansi.bright_green": "{{ color10 }}",
        "terminal.ansi.dim_green": "{{ dim2 }}",
        "terminal.ansi.yellow": "{{ color3 }}",
        "terminal.ansi.bright_yellow": "{{ color11 }}",
        "terminal.ansi.dim_yellow": "{{ dim3 }}",
        "terminal.ansi.blue": "{{ color4 }}",
        "terminal.ansi.bright_blue": "{{ color12 }}",
        "terminal.ansi.dim_blue": "{{ dim4 }}",
        "terminal.ansi.magenta": "{{ color5 }}",
        "terminal.ansi.bright_magenta": "{{ color13 }}",
        "terminal.ansi.dim_magenta": "{{ dim5 }}",
        "terminal.ansi.cyan": "{{ color6 }}",
        "terminal.ansi.bright_cyan": "{{ color14 }}",
        "terminal.ansi.dim_cyan": "{{ dim6 }}",
        "terminal.ansi.white": "{{ color7 }}",
        "terminal.ansi.bright_white": "{{ color15 }}",
        "terminal.ansi.dim_white": "{{ dim7 }}",
        "link_text.hover": "{{ accent }}",
        "conflict": "{{ warning }}",
        "conflict.background": "{{ warning_bg }}",
        "conflict.border": "{{ warning_border }}",
        "created": "{{ success }}",
        "created.background": "{{ info_bg }}",
        "created.border": "{{ success_border }}",
        "deleted": "{{ urgent }}",
        "deleted.background": "{{ diff_delete }}",
        "deleted.border": "{{ urgent_border }}",
        "error": "{{ urgent }}",
        "error.background": "{{ diff_delete }}",
        "error.border": "{{ urgent_border }}",
        "warning": "{{ warning }}",
        "warning.background": "{{ warning_bg }}",
        "warning.border": "{{ warning_border }}",
        "info": "{{ success }}",
        "info.background": "{{ info_bg }}",
        "info.border": "{{ success_border }}",
        "hint": "{{ placeholder }}",
        "hint.background": "{{ surface }}",
        "hint.border": "{{ border }}",
        "success": "{{ success }}",
        "success.background": "{{ info_bg }}",
        "success.border": "{{ success_border }}",
        "modified": "{{ accent }}",
        "modified.background": "{{ diff_change }}",
        "modified.border": "{{ accent_border }}",
        "renamed": "{{ special }}",
        "renamed.background": "{{ special_bg }}",
        "renamed.border": "{{ special_border }}",
        "hidden": "{{ placeholder }}",
        "hidden.background": "{{ surface }}",
        "hidden.border": "{{ border }}",
        "ignored": "{{ placeholder }}",
        "ignored.background": "{{ surface }}",
        "ignored.border": "{{ border }}",
        "predictive": "{{ placeholder }}",
        "predictive.background": "{{ surface }}",
        "predictive.border": "{{ border }}",
        "unreachable": "{{ disabled }}",
        "unreachable.background": "{{ surface }}",
        "unreachable.border": "{{ border }}",
        "players": [
          {
            "cursor": "{{ accent }}",
            "background": "{{ accent }}",
            "selection": "{{ accent }}3d"
          },
          {
            "cursor": "{{ success }}",
            "background": "{{ success }}",
            "selection": "{{ success }}3d"
          },
          {
            "cursor": "{{ string }}",
            "background": "{{ string }}",
            "selection": "{{ string }}3d"
          },
          {
            "cursor": "{{ special }}",
            "background": "{{ special }}",
            "selection": "{{ special }}3d"
          },
          {
            "cursor": "{{ escape }}",
            "background": "{{ escape }}",
            "selection": "{{ escape }}3d"
          },
          {
            "cursor": "{{ urgent }}",
            "background": "{{ urgent }}",
            "selection": "{{ urgent }}3d"
          },
          {
            "cursor": "{{ subtle }}",
            "background": "{{ subtle }}",
            "selection": "{{ subtle }}3d"
          },
          {
            "cursor": "{{ variable }}",
            "background": "{{ variable }}",
            "selection": "{{ variable }}3d"
          }
        ],
        "syntax": {
          "keyword": {
            "color": "{{ keyword }}"
          },
          "tag": {
            "color": "{{ keyword }}"
          },
          "variable.special": {
            "color": "{{ keyword }}",
            "font_style": "italic"
          },
          "function": {
            "color": "{{ function }}"
          },
          "function.special": {
            "color": "{{ function }}"
          },
          "type": {
            "color": "{{ type }}"
          },
          "type.builtin": {
            "color": "{{ type }}"
          },
          "constructor": {
            "color": "{{ type }}"
          },
          "enum": {
            "color": "{{ type }}"
          },
          "string": {
            "color": "{{ string }}"
          },
          "text.literal": {
            "color": "{{ string }}"
          },
          "string.regex": {
            "color": "{{ regex }}"
          },
          "string.escape": {
            "color": "{{ escape }}"
          },
          "string.special": {
            "color": "{{ escape }}"
          },
          "string.special.symbol": {
            "color": "{{ number }}"
          },
          "number": {
            "color": "{{ number }}"
          },
          "boolean": {
            "color": "{{ number }}"
          },
          "constant": {
            "color": "{{ number }}"
          },
          "variant": {
            "color": "{{ number }}"
          },
          "attribute": {
            "color": "{{ attribute }}"
          },
          "lifetime": {
            "color": "{{ escape }}",
            "font_style": "italic"
          },
          "label": {
            "color": "{{ escape }}"
          },
          "preproc": {
            "color": "{{ escape }}"
          },
          "punctuation.special": {
            "color": "{{ escape }}"
          },
          "variable": {
            "color": "{{ variable }}"
          },
          "variable.parameter": {
            "color": "{{ variable }}"
          },
          "embedded": {
            "color": "{{ variable }}"
          },
          "primary": {
            "color": "{{ variable }}"
          },
          "property": {
            "color": "{{ attribute }}"
          },
          "namespace": {
            "color": "{{ attribute }}"
          },
          "operator": {
            "color": "{{ operator }}"
          },
          "punctuation": {
            "color": "{{ punctuation }}"
          },
          "punctuation.bracket": {
            "color": "{{ bracket }}"
          },
          "punctuation.delimiter": {
            "color": "{{ punctuation }}"
          },
          "punctuation.list_marker": {
            "color": "{{ keyword }}"
          },
          "comment": {
            "color": "{{ comment }}",
            "font_style": "italic"
          },
          "comment.doc": {
            "color": "{{ muted }}",
            "font_style": "italic"
          },
          "hint": {
            "color": "{{ placeholder }}",
            "font_style": "italic"
          },
          "predictive": {
            "color": "{{ placeholder }}",
            "font_style": "italic"
          },
          "title": {
            "color": "{{ accent }}",
            "font_weight": 700
          },
          "emphasis": {
            "font_style": "italic"
          },
          "emphasis.strong": {
            "color": "{{ foreground }}",
            "font_weight": 700
          },
          "link_text": {
            "color": "{{ function }}"
          },
          "link_uri": {
            "color": "{{ type }}",
            "font_style": "italic"
          }
        }
      }
    }
  ]
}
