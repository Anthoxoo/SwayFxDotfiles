# Generated by ~/.config/themes/theme (template: templates/zsh.zsh)
# Sourced by the "theme" oh-my-zsh theme, and re-sourced at the next prompt after a switch.
typeset -g c_fg='{{ foreground }}' c_dim='{{ muted }}' c_accent='{{ accent }}' c_err='{{ urgent }}'

export LS_COLORS="di=38;2;{{ accent_ansi }}:ow=38;2;{{ accent_ansi }}:tw=38;2;{{ accent_ansi }}:st=38;2;{{ accent_ansi }}\
:ln=38;2;{{ ls_link_ansi }}:ex=38;2;{{ ls_exec_ansi }}\
:or=38;2;{{ urgent_ansi }}:mi=38;2;{{ urgent_ansi }}:su=38;2;{{ urgent_ansi }}:sg=38;2;{{ urgent_ansi }}\
:so=38;2;{{ color5_ansi }}:pi=38;2;{{ color5_ansi }}:bd=38;2;{{ muted_ansi }}:cd=38;2;{{ muted_ansi }}\
:*.zip=38;2;{{ ls_archive_ansi }}:*.tar=38;2;{{ ls_archive_ansi }}:*.gz=38;2;{{ ls_archive_ansi }}:*.xz=38;2;{{ ls_archive_ansi }}:*.7z=38;2;{{ ls_archive_ansi }}\
:*.png=38;2;{{ color5_ansi }}:*.jpg=38;2;{{ color5_ansi }}:*.jpeg=38;2;{{ color5_ansi }}:*.svg=38;2;{{ color5_ansi }}:*.webp=38;2;{{ color5_ansi }}\
:*.mp4=38;2;{{ color5_ansi }}:*.mkv=38;2;{{ color5_ansi }}:*.mp3=38;2;{{ color5_ansi }}:*.flac=38;2;{{ color5_ansi }}"
zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"

ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE='fg={{ line_nr }}'
