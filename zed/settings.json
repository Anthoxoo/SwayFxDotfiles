{
  "inlay_hints": {
    "enabled": true
  },
  "terminal": {
    "font_family": "JetBrainsMono Nerd Font",
    "font_size": 15
  },
  "lsp": {
    "qml": {
      "binary": {
        "path": "/usr/sbin/qmlls6",
        "arguments": ["-E"]
      }
    },
    "rust-analyzer": {
      "initialization_options": {
        "inlayHints": {
          "maxLength": 25,
          "typeHints": {
            "enable": true,
            "hideNamedConstructor": true,
            "hideClosureInitialization": true
          },
          "parameterHints": {
            "enable": false
          },
          "chainingHints": {
            "enable": false
          },
          "lifetimeElisionHints": {
            "enable": "never"
          },
          "closureReturnTypeHints": {
            "enable": "with_block"
          }
        }
      }
    }
  },
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left",
    "indent_size": 16
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "session": {
    "trust_all_worktrees": true
  },
  "buffer_line_height": "comfortable",
  "ui_font_family": "JetBrainsMono Nerd Font",
  "ui_font_size": 17.0,
  "buffer_font_family": "JetBrainsMono Nerd Font",
  "buffer_font_size": 18.0,
  "disable_ai": true,
  "telemetry": {
    "diagnostics": false,
    "metrics": false
  },
  "colorize_brackets": true,
  "base_keymap": "VSCode",
  "vim_mode": true,
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Warm Charmed Icons"
  },
  "theme": {
    "mode": "dark",
    "light": "One Dark",
    "dark": "Orange Black"
  },
  "tab_bar": {
    "show": false
  },
  "toolbar": {
    "quick_actions": false
  },
  "scrollbar": {
    "show": "auto"
  },
  "gutter": {
    "runnables": false
  },
  "indent_guides": {
    "enabled": true,
    "line_width": 1,
    "active_line_width": 1,
    "coloring": "fixed",
    "background_coloring": "disabled"
  },
  "experimental.theme_overrides": {
    "editor.indent_guide": "#ffffff10",
    "editor.indent_guide_active": "#ff8800",
    "syntax": {
      "hint": {
        "color": "#5c7582",
        "font_style": "italic"
      }
    }
  },
  "title_bar": {
    "show_user_picture": false
  }
}
